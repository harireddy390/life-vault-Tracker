# Life Vault Backend Environment Configuration

# Server
PORT=4003
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/lifevault

# Security / JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars

# AI Assistant
GROQ_API_KEY=your_groq_api_key_here

# Frontend / CORS
CLIENT_URL=http://localhost:5173

# Email / SMTP Delivery (Password Reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=Life Vault <noreply@lifevault.app>
