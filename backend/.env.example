# Life Vault Backend Environment Configuration

# Server
PORT=4003
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/lifevault

# Security / JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars

# AI Assistant
GROQ_API_KEY=your_groq_api_key_here

# Frontend / CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# ─── Email / Transactional Email (Password Reset OTP) ──────────────────────
#
# Production provider: Brevo HTTPS Transactional Email API
#   Free tier: 300 emails/day, no credit card required.
#   Works on Render Free (HTTPS port 443 — not blocked like SMTP).
#
#   Setup steps:
#     1. Create a free Brevo account at https://app.brevo.com
#     2. Go to: Transactional → API Keys → Generate a new API key
#     3. Go to: Settings → Senders & IP → Senders → Add a verified sender
#     4. Set BREVO_API_KEY and MAIL_FROM below
#
# Production (Render dashboard): add BREVO_API_KEY and MAIL_FROM.
# Development: leave BREVO_API_KEY blank to use the console OTP fallback.
#
BREVO_API_KEY=your_brevo_api_key_here
MAIL_FROM=LifeVault <noreply@yourdomain.com>

# ─── Legacy SMTP (optional, local testing only) ─────────────────────────────
# Not used in production — Render Free blocks outbound SMTP connections.
# Only set these if you want to test SMTP locally with a tool like Mailtrap.
#
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email@example.com
# SMTP_PASSWORD=your_brevo_smtp_key_here

# ─── Web Push / VAPID Keys (Routine Reminders) ──────────────────────────────
# Generated via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@yourdomain.com
