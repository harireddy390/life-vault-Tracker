# Life Vault Backend Environment Configuration

# Server
PORT=4003
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/lifevault

# Security / JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars

# AI Assistant
GROQ_API_KEY=your_groq_api_key_here

# Frontend / CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# ─── Email / SMTP Delivery (Password Reset OTP) ────────────────────────────
#
# Recommended free provider: Brevo (https://app.brevo.com)
#   Free tier: 300 emails/day, no credit card required.
#   Setup steps:
#     1. Create a free Brevo account at https://app.brevo.com
#     2. Go to: SMTP & API → SMTP → Generate a new SMTP Key
#     3. Verify a sender email address (Settings → Senders & IP → Senders)
#     4. Copy the four values below from the Brevo SMTP settings panel
#
# Production (Render): add these as environment variables in the Render dashboard.
# Development: fill them in here locally, or leave blank to use the console fallback.
#
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASSWORD=your_brevo_smtp_key_here
MAIL_FROM=LifeVault <noreply@yourdomain.com>
